<Window x:Class="ShowWhatProcessLocksFile.Gui.Utils.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Error"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        MaxWidth="700">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Column="0" Grid.Row="0" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,12,0"
                        Content="{StaticResource StatusError_icon}" />
        <TextBox x:Name="Message" Grid.Column="1" Grid.Row="0"
                 Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalAlignment="Center" FontSize="14" />
        <Button Grid.Column="1" Grid.Row="1" Content="OK" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" MinWidth="80" Padding="4" Margin="0,12,0,0" />
    </Grid>
</Window>
