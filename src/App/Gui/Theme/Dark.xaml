<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#202020</Color>
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="DisabledTextColor">#7A7A7A</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="#262626" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#264F78" />
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#3A3D41" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#202020" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="ProgressBarBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="IconBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="IconAccentBrush" Color="#75BEFF" />

    <!-- Default WPF styles (Window, Label, ScrollViewer corner) read these system keys via DynamicResource -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource DisabledTextColor}" />
</ResourceDictionary>
