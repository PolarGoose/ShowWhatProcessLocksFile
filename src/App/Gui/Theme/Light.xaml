<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#000000</Color>
    <Color x:Key="DisabledTextColor">#6D6D6D</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#E5F1FB" />
    <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="#CCE4F7" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#ADADAD" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#CCE8FF" />
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#CDCDCD" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="ProgressBarBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="IconBrush" Color="#212121" />
    <SolidColorBrush x:Key="IconAccentBrush" Color="#005DBA" />

    <!-- Default WPF styles (Window, Label, ScrollViewer corner) read these system keys via DynamicResource -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource DisabledTextColor}" />
</ResourceDictionary>
